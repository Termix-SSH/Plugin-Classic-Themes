{
  "name": "@termix-plugin/classic-themes",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "build": "termix-plugin build",
    "test": "termix-plugin test",
    "typecheck": "tsc -p .",
    "validate": "termix-plugin validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@termix-ssh/plugin-sdk": "^2.2.1",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "3.10.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@termix-ssh/plugin-sdk": "^2.2.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "glob@12": "^14.0.4",
    "minimatch@10": "^11.0.5"
  }
